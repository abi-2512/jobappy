{
  "manifest_version": 3,
  "name": "JobAppy — Resume Tailor",
  "version": "0.1.0",
  "description": "Tailor your resume to any job posting and export a clean PDF, using free Gemini and NVIDIA NIM keys.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
